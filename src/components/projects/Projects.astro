---
import { projectData } from "../../data/project_data";
import ProjectCard from "./ProjectCard.svelte";
---

<section
  class="h-fit max-h-min border-y-2 border-ink bg-skyblue px-5 py-14 md:px-10 lg:px-28"
  id="projects"
>
  <div class="flex flex-col items-center justify-center">
    <p class="type-micro font-bold">
      <span class="text-accent">///</span> {"04 — INDEX OF WORK"}
    </p>
    <p class="type-macro mt-2 text-[clamp(2.5rem,10vw,3.75rem)] text-ink">{"Projects"}</p>

    <p class="max-w-3xl py-2 text-center font-medium tracking-normal">
      {
        "These are some of the recent projects I have been deeply involved in, each reflecting my commitment to innovation and delivering impactful results."
      }
    </p>
  </div>
  <div class="grid grid-cols-1 gap-5 py-4 md:grid-cols-2 lg:grid-cols-3">
    {projectData.filter((e) => e.pinned).map((e) => <ProjectCard {...e} />)}
  </div>
  <div class="text-center">
    <a
      class="type-micro inline-flex justify-center border-2 border-ink bg-teal px-10 py-3 font-bold text-ink transition-colors my-5 hover:bg-ink hover:text-paper"
      href="/projects"
    >
      {"View More Projects >>>"}
    </a>
  </div>
</section>
