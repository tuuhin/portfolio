---
import { HERO_TITLE, HERO_DESC } from "@data/Constants";
import Image from "astro/components/Image.astro";
import heroImage from "../../image/me.webp";
---

<section
  class="relative border-b-2 border-ink bg-mintgreen px-5 py-14 md:space-y-4 lg:px-28 lg:py-20"
>
  <span class="crosshair left-3 top-3" aria-hidden="true">+</span>
  <span class="crosshair right-3 top-3" aria-hidden="true">+</span>

  <div
    class="flex h-3/5 flex-col items-center lg:flex-row-reverse lg:justify-around"
  >
    <div class="relative w-full md:w-2/5">
      <span class="crosshair -left-3 -top-3" aria-hidden="true">+</span>
      <span class="crosshair -bottom-3 -right-3" aria-hidden="true">+</span>
      <Image
        src={heroImage}
        alt={"This is me, tuhin bhowmick"}
        widths={[240, 540, 720, heroImage.width]}
        sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${heroImage.width}px`}
        class={
          "mx-auto w-72 max-w-full border-2 border-ink grayscale contrast-125 lg:w-2/3"
        }
        loading={"eager"}
        decoding={"auto"}
      />
    </div>

    <div
      class="flex max-w-md flex-col items-center py-2 md:max-w-xl lg:items-start"
    >
      <p class="type-micro font-bold">
        {"[ ANDROID ]"} <span class="text-accent">///</span>
        {"[ KOTLIN ]"} <span class="text-accent">///</span>
        {"[ KMP ]"}
      </p>
      <h1 class="type-macro mt-5 text-[clamp(3rem,9vw,7.5rem)] text-ink">
        {HERO_TITLE}
      </h1>
      <p
        class="mt-4 font-mono text-xs uppercase font-bold tracking-[0.08em] text-ink md:text-sm"
      >
        <span class="text-accent">{">>>"}</span>
        {" Android Developer — On-device AI / BLE / C-C++ Interop"}
      </p>
      <p class="pt-4 text-center text-lg font-medium text-ink lg:text-left">
        {HERO_DESC}
      </p>
    </div>
  </div>
</section>
