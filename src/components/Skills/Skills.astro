---
const skillGroups: { label: string; skills: string[] }[] = [
  {
    label: "Languages",
    skills: ["Kotlin", "C/C++", "SQL", "Python"],
  },
  {
    label: "Android & Multiplatform",
    skills: [
      "Android SDK",
      "Jetpack Compose",
      "Compose Multiplatform",
      "Kotlin Multiplatform",
      "Android NDK",
    ],
  },
  {
    label: "Backend & Data",
    skills: [
      "Ktor",
      "Spring Boot",
      "Firebase",
      "REST APIs",
      "WebSockets",
      "Protocol Buffers",
    ],
  },
  {
    label: "Native & Systems",
    skills: ["JNI", "C-Interop", "Kotlin/Native", "BLE"],
  },
  {
    label: "Tools & Practices",
    skills: ["Git", "Gradle", "Android Studio"],
  },
];

const chipPalette = [
  "bg-salmon",
  "bg-blush",
  "bg-skyblue",
  "bg-butter",
  "bg-mint",
  "bg-teal",
];
---

<section
  class="border-b-2 border-ink bg-mint px-5 py-14 md:px-10 lg:px-28"
  id="skills"
>
  <div class="flex w-full flex-col items-center space-y-4">
    <p class="type-micro font-bold">
      <span class="text-accent">///</span> {"02 — CAPABILITIES"}
    </p>
    <h2 class="type-macro text-[clamp(2.5rem,10vw,3.75rem)] text-ink">{"Skills"}</h2>
    <p class="max-w-4/5 text-center text-md font-medium">
      {
        "Specializing in Kotlin, Android development, Kotlin Multiplatform, and Compose Multiplatform — cross-platform applications, native integrations, and backend services."
      }
    </p>
  </div>

  <div class="mt-10 grid gap-px border-2 border-ink bg-ink">
    {
      skillGroups.map((group) => (
        <div class="grid gap-px bg-ink md:grid-cols-[240px_1fr]">
          <header class="flex items-center bg-ink p-4 md:p-5">
            <p class="type-micro font-bold text-paper">{group.label}</p>
          </header>
          <ul class="flex flex-wrap content-center gap-2 bg-paper p-4 md:p-5">
            {group.skills.map((skill, i) => (
              <li
                class={`type-micro border border-ink px-2 py-1 font-bold text-ink transition-colors hover:bg-ink hover:text-paper ${chipPalette[i % chipPalette.length]}`}
              >
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="type-micro py-4 text-center">
    {
      " * Currently focusing on mobile development,thus mobile technologies are more brushed"
    }
  </p>
</section>
