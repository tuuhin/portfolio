---
import {
  HOME_TITLE,
  HOME_DESC,
  OG_IMAGE,
  WEBSITE_URL,
  JSON_LD_SCHEMA,
} from "../data/Constants.ts";

import "../styles/global.css";

import { ClientRouter } from "astro:transitions";
import { Schema } from "astro-seo-schema";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={HOME_DESC} />
    <!--Facebook meta tags -->
    <meta property="og:title" content={HOME_TITLE} />
    <meta property="og:description" content={HOME_DESC} />
    <meta property="og:url" content={WEBSITE_URL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={OG_IMAGE} />
    <!--Twitter meta tags -->
    <meta name="twitter:title" content={HOME_TITLE} />
    <meta name="twitter:description" content={HOME_DESC} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="tuhinbhowmick.in" />
    <meta property="twitter:url" content={WEBSITE_URL} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <!-- Apple touch icon -->
    <link rel="apple-touch-icon" href="./favicon/icons8-student-16.png" />
    <link
      type="image/png"
      sizes="16x16"
      rel="icon"
      href="./favicon/icons8-student-16.png"
    />
    <link
      type="image/png"
      sizes="32x32"
      rel="icon"
      href="./favicon/icons8-student-32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="./favicon/icons8-student-96.png"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{HOME_TITLE}</title>
    <ClientRouter />
    <!-- Analytics -->
    <script
      is:inline
      type="text/partytown"
      src=`https://www.googletagmanager.com/gtag/js?id=G-83XB4SPKEJ`></script>
    <script is:inline type="text/partytown">
      const G_TAG = "G-83XB4SPKEJ";
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", G_TAG);
      console.log("ANALYTICS IMPLANTED");
    </script>
    <!-- Analytics -->
  </head>
  <body>
    <Schema item={JSON_LD_SCHEMA} />
    <div class="noise-overlay" aria-hidden="true"></div>
    <main>
      <slot />
    </main>
  </body>
</html>
